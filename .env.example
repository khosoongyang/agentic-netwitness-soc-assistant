# Copy this file to .env for local use: `cp .env.example .env`
# Never commit real credentials. .gitignore already excludes .env.
#
# Every variable below is read directly by the application (verified by
# searching the codebase, not assumed) - if a variable you remember from an
# older version of this project isn't here, it's no longer read anywhere.

# ── OpenAI (required for AI-assisted triage/investigation/reporting/Ask
#    Aegis; the app still runs without it, with those features degraded) ──
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: fixed sampling seed for more reproducible model output.
OPENAI_SEED=

# ── Threat-intelligence providers (optional; enrichment degrades gracefully
#    per-provider when a key is missing) ──
VT_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=

# ── NetWitness (leave blank to run Aegis in offline/cached-case mode) ──
NW_HOST=
NW_USERNAME=
NW_PASSWORD=
NW_TOKEN=
NW_AUTH_STYLE=NetWitness-Token
# TLS verification defaults to true (secure). Only set this to false for a
# trusted internal NetWitness appliance using a self-signed certificate you
# cannot add a CA bundle for - development/demo use only. Prefer
# NW_CERT_PATH below instead where possible.
NETWITNESS_VERIFY_SSL=true
# Path to a CA bundle file to verify NetWitness's certificate against,
# instead of disabling verification.
NW_CERT_PATH=

# ── Vector store (optional; Chroma search degrades to "unavailable" when
#    unset and no OpenAI key is configured for embeddings) ──
AEGIS_CHROMA_DB_PATH=runtime/chroma

# ── Reporting agent tuning (optional; all have working defaults) ──
# Set to false to skip LLM-generated narrative text and use deterministic
# templated report sections instead.
REPORTING_USE_LLM=true
# openai (default) | ollama (local model, needs a running Ollama server -
# see REPORTING_OLLAMA_BASE_URL/REPORTING_OLLAMA_MODEL) | mock (offline/CI)
REPORTING_LLM_PROVIDER=openai
REPORTING_LLM_MODEL=gpt-4o-mini
REPORTING_OLLAMA_BASE_URL=http://localhost:11434
REPORTING_OLLAMA_MODEL=llama3.2:3b
# Retrieval-augmented context from the knowledge base (playbooks/policies).
REPORTING_USE_RAG=true
# Use Chroma for RAG retrieval instead of the built-in text search.
REPORTING_USE_CHROMADB=false
# Optional: mirror each finished report result to Postgres (off by default;
# a missing/unreachable database is a non-fatal, logged warning, not a
# failure - report generation itself never depends on this).
REPORTING_USE_POSTGRES=false
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/aegis_soc
# Additional low-level reporting-agent tuning (timeouts, retries, cache,
# temperature, narrative depth, ...) is documented in
# agents/reporting/config/settings.py and has sensible defaults - not
# reproduced here to keep this file practical.
