# Copy this file to .env for local use. Never commit real credentials.

# LLM provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional threat-intelligence providers
VT_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=

# NetWitness (leave blank for offline/cached-case mode)
NW_HOST=
NW_USERNAME=
NW_PASSWORD=
NW_TOKEN=
NW_AUTH_STYLE=NetWitness-Token
NW_CERT_PATH=
NETWITNESS_VERIFY_SSL=false

# Optional mutable vector-store location
AEGIS_CHROMA_DB_PATH=runtime/chroma
