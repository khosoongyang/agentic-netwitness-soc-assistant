# =============================================================================
# [FYP-FILE] FILE OVERVIEW
# [FYP-SECTION] EXECUTABLE / BEHAVIOURAL CONFIGURATION
# =============================================================================
# File: .streamlit/secrets.toml.example
# Purpose: This file documents the secret names expected by Streamlit without containing live credential values.
# Main functionality: Supplies runtime, dependency, security, workflow, or
#   playbook values consumed by the application/framework named below.
# Inputs: Maintainer-controlled configuration values; no live secret values
#   are documented or introduced by this overview.
# Outputs: Configuration read by the framework, installer, CI job, or Aegis
#   component; it does not independently execute a workflow stage.
# Workflow position: Supporting configuration for Streamlit runtime configuration.
# Important dependencies: The consuming application/framework and the exact
#   keys or steps declared in this file.
# Error and fallback behaviour: Invalid values fail in the consuming parser,
#   installer, workflow, or framework; fallback behaviour belongs to that caller.
# Key evaluator search terms: secrets.toml.example, [FYP-CONFIG], [FYP-FILE].
# =============================================================================
# [FYP-CONFIG] Purpose: template listing the secrets/env vars the deployed
# app expects (LLM key/model, optional dev password, on-prem NetWitness
# creds). Not read directly — a real .streamlit/secrets.toml (gitignored,
# copied from this template) is read by Streamlit as st.secrets; app.py
# copies its entries into os.environ at startup (see app.py ~line 147-162).
# ─────────────────────────────────────────────────────────────────────
# Streamlit Community Cloud secrets TEMPLATE
# ─────────────────────────────────────────────────────────────────────
# Do NOT put real values in a committed file. Instead, in the Streamlit
# Cloud dashboard:  your app  →  Settings  →  Secrets  →  paste the block
# below (with real values).  app.py copies these into os.environ at boot,
# so every existing os.environ.get(...) keeps working with no code change.
#
# (For LOCAL testing of the cloud path you may copy this to
#  .streamlit/secrets.toml and fill it in — that file is gitignored.)

# ── LLM provider (required for the 3 agents to run) ──────────────────
OPENAI_API_KEY = "sk-xxxxxxxxxxxxxxxxxxxx"
OPENAI_MODEL   = "gpt-4o-mini"

# ── RBAC: developer access (optional) ────────────────────────────────
# The app defaults every visitor to a read-only GUEST who cannot see the
# developer Knowledge Base (ChromaDB) tab. Set a password here to reveal a
# "Developer access" sign-in in the sidebar; entering it unlocks the dev tab.
# Leave it unset and the app stays guest-only (no dev sign-in shown).
# (Local dev without secrets: set the APP_DEV_PASSWORD env var instead.)
DEV_PASSWORD = "choose-a-strong-developer-password"

# ── NetWitness (leave blank in the cloud) ────────────────────────────
# NetWitness is on-prem / VPN-only and unreachable from Streamlit Cloud.
# Leave these unset so the app stays in offline/demo mode, serving the
# stored incidents bundled in soc_db/ and chroma_db/.
# NW_HOST     = ""
# NW_USERNAME = ""
# NW_PASSWORD = ""
