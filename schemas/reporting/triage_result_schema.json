      "title": "TriageCitationError",
      "type": "object"
    },
    "TriageClaim": {
      "additionalProperties": false,
      "description": "One piece of reasoning with the evidence-packet dot-paths it rests\non. After agents/triage/guards.verify_citations() every surviving claim\nhas >= 1 valid cite (existing path, status != missing).",
      "properties": {
        "claim": {
          "title": "Claim",
          "type": "string"
        },
        "cites": {
          "items": {
            "type": "string"
          },
          "title": "Cites",
          "type": "array"
        }
      },
      "required": [
        "claim",
        "cites"
      ],
      "title": "TriageClaim",
      "type": "object"
    },
    "TriageGuardAction": {
      "additionalProperties": false,
      "description": "One Python-guard override of the model's disposition. Serialized\nwith the key \"from\" (a Python keyword, hence the `from_` alias).",
      "properties": {
        "rule": {
          "title": "Rule",
          "type": "string"
        },
        "from": {
          "title": "From",
          "type": "string"
        },
        "to": {
          "title": "To",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "rule",
        "from",
        "to",
        "reason"
      ],
      "title": "TriageGuardAction",
      "type": "object"
    },
    "TriageHypotheses": {
      "additionalProperties": false,
      "description": "The two competing explanations: malicious activity vs normal\noperations.",
      "properties": {
        "malicious": {
          "$ref": "#/$defs/TriageHypothesis"
        },
        "benign": {
          "$ref": "#/$defs/TriageHypothesis"
        }
      },
      "title": "TriageHypotheses",
      "type": "object"
    },
    "TriageHypothesis": {
      "additionalProperties": false,
      "properties": {
